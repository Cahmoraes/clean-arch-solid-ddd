{
	"name": "monorepo",
	"private": true,
	"packageManager": "pnpm@11.5.3",
	"type": "module",
	"scripts": {
		"dev": "pnpm generate:types && turbo dev",
		"build": "pnpm generate:types && turbo build",
		"test": "turbo test",
		"lint": "turbo lint",
		"backend:tsc:check": "pnpm --filter backend tsc:check",
		"backend:test": "pnpm --filter backend test",
		"front:tsc:check": "pnpm --filter frontend tsc:check",
		"front:test": "pnpm --filter backend test",
		"generate:types": "pnpm --filter backend openapi:export && pnpm --filter @repo/api-types openapi:generate-client"
	},
	"devDependencies": {
		"turbo": "latest"
	}
}
